# Template for `.env.test` — server-side-only env stubs for the live-API integration
# matrix of the OpenAI Chat Completions battery. Consumed by the gated live-API
# describe blocks in:
#   tests/unit/batteries/llm/openai_chat_completions/adapter.cross.spec.ts
#
# Copy to `.env.test` (which is gitignored) and fill in real values. Do NOT commit
# real credentials. This `.example` file ships with blank values so the convention
# is discoverable without leaking secrets.
#
# Server-side-only env stubs for live-API integration testing of the
# OpenAI Chat Completions battery. Consumed by the gated live-API
# describe block in:
#   tests/unit/batteries/llm/openai_chat_completions/adapter.cross.spec.ts
#
# This file is gitignored. Do NOT commit real credentials.
#
# To run the live-API test locally:
#   1. Populate TEST_OPENAI_API_KEY below with a real key.
#   2. (Optional) Set TEST_OPENAI_MODEL / TEST_OPENAI_BASE_URL.
#   3. Source this file, then run vitest under the node project:
#        set -a && source .env.test && set +a
#        pnpm vitest run tests/unit/batteries/llm/openai_chat_completions/adapter.cross.spec.ts --project node
#
# The live block is gated on `typeof process !== 'undefined' &&
# process.env.TEST_OPENAI_API_KEY`, so it only ever runs server-side
# (the cross-spec runs under node, chromium, firefox, webkit projects;
# browser projects skip the live block automatically).

# Required — your OpenAI API key (or any OpenAI-Chat-Completions-compatible
# gateway key: OpenRouter, Together, Groq, LiteLLM, etc.).
TEST_OPENAI_API_KEY=

# Optional — model identifier. Defaults to 'gpt-4o-mini' when unset.
TEST_OPENAI_MODEL=

# Optional — point at any OpenAI-Chat-Completions-compatible endpoint
# (OpenRouter, Together, Groq, Ollama /v1, vLLM, LM Studio, llama.cpp /v1,
# LiteLLM, a custom gateway). Leave blank to use https://api.openai.com/v1.
TEST_OPENAI_BASE_URL=

# claude-haiku-4-5
TEST_OPENAI_CLAUDE_HAIKU_4_5_API_KEY=
TEST_OPENAI_CLAUDE_HAIKU_4_5_BASE_URL=

# gemini-3.5-flash
TEST_OPENAI_GEMINI_3_5_FLASH_API_KEY=
TEST_OPENAI_GEMINI_3_5_FLASH_BASE_URL=

# gemma4 (gemma4:31b via the load balancer)
TEST_OPENAI_GEMMA4_API_KEY=
TEST_OPENAI_GEMMA4_BASE_URL=

# gemma4-workstation (gemma4:12b-mlx — workstation-targeted quant, e.g. local Ollama)
#   API key is a placeholder for Ollama (ignored, but must be non-empty).
TEST_OPENAI_GEMMA4_WORKSTATION_API_KEY=
TEST_OPENAI_GEMMA4_WORKSTATION_BASE_URL=http://localhost:11434/v1

# deepseek-v4-flash
TEST_OPENAI_DEEPSEEK_V4_FLASH_API_KEY=
TEST_OPENAI_DEEPSEEK_V4_FLASH_BASE_URL=

# glm-5.1
TEST_OPENAI_GLM_5_1_API_KEY=
TEST_OPENAI_GLM_5_1_BASE_URL=

# gpt-oss:20b
TEST_OPENAI_GPT_OSS_20B_API_KEY=
TEST_OPENAI_GPT_OSS_20B_BASE_URL=

# kimi-k2.6
TEST_OPENAI_KIMI_K2_6_API_KEY=
TEST_OPENAI_KIMI_K2_6_BASE_URL=

# ── Native Ollama battery — live /api/chat integration ──────────────────────
# Gated live test for the native Ollama battery (`OllamaAdapter`, /api/chat), in:
#   tests/functional/batteries/llm/ollama/real_llm.node.spec.ts
# The whole suite skips unless TEST_OLLAMA_BASE_URL and TEST_OLLAMA_MODEL are set
# (green, not red). TEST_OLLAMA_API_KEY is optional — omit it for a local Ollama
# (no auth); set it for cloud Ollama or any gateway requiring Authorization: Bearer.
#
# IMPORTANT: point TEST_OLLAMA_BASE_URL at the host ROOT, NOT a /v1 path — the
# adapter targets <baseURL>/api/chat, so a /v1 suffix yields /v1/api/chat (404).
# (The OpenAI battery, by contrast, wants the /v1 base.)
#   local:  http://localhost:11434
#   cloud:  https://ollama.com
TEST_OLLAMA_BASE_URL=
TEST_OLLAMA_API_KEY=
TEST_OLLAMA_MODEL=

# ── Vector storage battery — integration backends ───────────────────────────
# Each adapter's functional suite is gated on its TEST_VECTOR_<ADAPTER>_URL: set the
# URL to run that suite, leave blank to skip (green, not red). Cheapest first.
# sqlite-vec: no server — set to a file path or :memory: to enable the suite.
TEST_VECTOR_SQLITE_VEC_URL=:memory:
# duckdb: no server — in-process via the vss extension; set to :memory: or a file path.
TEST_VECTOR_DUCKDB_URL=:memory:
# lancedb: no server — embedded; set =1 to enable (a temp dir is used per test).
TEST_VECTOR_LANCEDB_URL=1
# hnswlib: no server — embedded ANN (native addon, in-memory); set =1 to enable.
TEST_VECTOR_HNSWLIB_URL=1
# apache solr — http://host:8983 with a precreated core named 'docs' (solr-precreate docs).
# Run locally via: docker compose -f docker-compose.vector.yml --profile solr up -d
# (CI matrix omits Solr: the shared services block can't pass the solr-precreate command.)
TEST_VECTOR_SOLR_URL=
# mongodb atlas vector search (mongodb/mongodb-atlas-local) — mongodb://host:27017/?directConnection=true
TEST_VECTOR_MONGODB_URL=
# couchbase ENTERPRISE (vector search is EE-only) — couchbase://host. Bucket must exist (docker init).
# Run locally via: docker compose -f docker-compose.vector.yml --profile couchbase up -d (wait for couchbase-init).
TEST_VECTOR_COUCHBASE_URL=
TEST_VECTOR_COUCHBASE_USER=Administrator
TEST_VECTOR_COUCHBASE_PASS=password123
TEST_VECTOR_COUCHBASE_BUCKET=vectors
# vespa — data/query endpoint (http://host:8080) + config server (http://host:19071). A collection
# is a document type in a deployed application package; the adapter deploys it via the config server.
# Run locally via: docker compose -f docker-compose.vector.yml --profile vespa up -d
TEST_VECTOR_VESPA_URL=
TEST_VECTOR_VESPA_CONFIG_URL=http://localhost:19071
# orama: no server, no infra — in-process; set =1 to enable.
TEST_VECTOR_ORAMA_URL=1
# pgvector (Postgres + vector extension)
TEST_VECTOR_PGVECTOR_URL=
# qdrant
TEST_VECTOR_QDRANT_URL=
TEST_VECTOR_QDRANT_API_KEY=
# redis / valkey (RediSearch) — redis://host:port
TEST_VECTOR_REDIS_URL=
# clickhouse — http://host:8123 (+ optional user/password/db)
TEST_VECTOR_CLICKHOUSE_URL=
TEST_VECTOR_CLICKHOUSE_USER=
TEST_VECTOR_CLICKHOUSE_PASSWORD=
TEST_VECTOR_CLICKHOUSE_DB=
# opensearch — http://host:9200 (OpenSearch's knn_vector/query.knn dialect)
TEST_VECTOR_OPENSEARCH_URL=
# elasticsearch 8 — http://host:9200 (ES8 dense_vector + top-level knn; separate adapter).
# Use the @elastic/elasticsearch v8 client against an 8.x server.
TEST_VECTOR_ELASTICSEARCH_URL=
# typesense — http://host:8108 (+ api key)
TEST_VECTOR_TYPESENSE_URL=
TEST_VECTOR_TYPESENSE_API_KEY=
# meilisearch — http://host:7700 (+ master key)
TEST_VECTOR_MEILISEARCH_URL=
TEST_VECTOR_MEILISEARCH_API_KEY=
# mariadb 11.7+ (native VECTOR) — mysql://user:pass@host:3306/db
TEST_VECTOR_MARIADB_URL=
# oracle 23ai (AI Vector Search) — EZConnect host:1521/FREEPDB1 + user/pass. The user's default
# tablespace must be non-SYSTEM (e.g. USERS); the docker `oracle` profile's APP_USER=vector does this.
TEST_VECTOR_ORACLE_URL=
TEST_VECTOR_ORACLE_USER=vector
TEST_VECTOR_ORACLE_PASS=vector
# surrealdb — http://host:8000 (+ user/pass, ns/db = test)
TEST_VECTOR_SURREALDB_URL=
TEST_VECTOR_SURREALDB_USER=
TEST_VECTOR_SURREALDB_PASS=
# neo4j 5.13+ (native vector index) — bolt://host:7687 (+ user/pass)
TEST_VECTOR_NEO4J_URL=
TEST_VECTOR_NEO4J_USER=
TEST_VECTOR_NEO4J_PASS=
# arangodb 3.12.4+ (server started with --experimental-vector-index=true) — http://host:8529
TEST_VECTOR_ARANGODB_URL=
TEST_VECTOR_ARANGODB_USER=
TEST_VECTOR_ARANGODB_PASS=
# chroma
TEST_VECTOR_CHROMA_URL=
# weaviate
TEST_VECTOR_WEAVIATE_URL=
TEST_VECTOR_WEAVIATE_API_KEY=
# milvus
TEST_VECTOR_MILVUS_URL=
TEST_VECTOR_MILVUS_TOKEN=
# pinecone (managed — needs key + index name; no local URL)
TEST_VECTOR_PINECONE_URL=
TEST_VECTOR_PINECONE_API_KEY=
TEST_VECTOR_PINECONE_INDEX=
# aws s3 vectors (managed — needs a pre-existing vector bucket; creds from the ambient AWS chain).
# Index names must be 3–63 chars. No local container.
TEST_VECTOR_S3VECTORS_BUCKET=
TEST_VECTOR_S3VECTORS_REGION=
# cloudflare vectorize v2 (managed — account id + API token). No local container. dims 32–1536.
# Note: Vectorize is aggressively eventually-consistent; the conformance spec uses vitest retry to
# ride out its read-after-write flap, so the suite is slow (~8 min) but deterministic.
TEST_VECTOR_CLOUDFLARE_ACCOUNT_ID=
TEST_VECTOR_CLOUDFLARE_API_KEY=
# Optional encoder for integration suites that exercise .nearText() end-to-end.
# Leave blank → those suites use a deterministic stub VectorEncoderFn instead.
TEST_VECTOR_ENCODER_BASE_URL=
TEST_VECTOR_ENCODER_API_KEY=
TEST_VECTOR_ENCODER_MODEL=

# searxng search tool — live integration. Consumed by the gated describe block in:
#   tests/functional/batteries/tools/searxng.integration.node.spec.ts
# TEST_SEARXNG_URL is the instance base URL; the suite skips entirely when it is blank.
# TEST_SEARXNG_HEADERS is an OPTIONAL JSON object of custom request headers (auth), e.g.
#   TEST_SEARXNG_HEADERS={"Authorization":"Bearer …"}
# The instance must have the JSON output format enabled (search.formats: [json]) or it 403s.
TEST_SEARXNG_URL=
TEST_SEARXNG_HEADERS=

# scrapper web-extraction tool — live integration. Consumed by the gated describe block in:
#   tests/functional/batteries/tools/scrapper.integration.node.spec.ts
# TEST_SCRAPPER_URL is the instance base URL; the suite skips entirely when it is blank.
# TEST_SCRAPPER_HEADERS is an OPTIONAL JSON object of instance-auth headers, e.g.
#   TEST_SCRAPPER_HEADERS={"x-api-key":"…"}
# (This is the auth sent to the Scrapper instance — NOT the extra-http-headers param the scraper
#  sends to the target site.)
TEST_SCRAPPER_URL=
TEST_SCRAPPER_HEADERS=
